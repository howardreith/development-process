{
  "schema_version": "agent-review.project.v1",
  "project_id": "nob",
  "repository": "LeitbyteLLC/NoelleBackEnd",
  "allowed_remote_urls": [
    "https://github.com/LeitbyteLLC/NoelleBackEnd.git",
    "git@github.com:LeitbyteLLC/NoelleBackEnd.git"
  ],
  "default_target_branch": "main",
  "branch_pattern": "^claude/[a-z0-9][a-z0-9._/-]*$",
  "expected_actor": "howardreith",
  "transcript_dir": "docs/agent-reviews",
  "instructions": [],
  "developer": {
    "executable": "%USERPROFILE%/.local/bin/claude.exe",
    "config_dir": "%USERPROFILE%/.claude-personal",
    "model": "opus",
    "effort": "high",
    "allowed_model_pattern": "^claude-opus-",
    "soft_deadline_minutes": 480,
    "grace_minutes": 60,
    "permissions": {
      "allow": [
        "Bash(npm test*)",
        "PowerShell(npm test*)",
        "Bash(npm run lint*)",
        "PowerShell(npm run lint*)",
        "Bash(npm.cmd test*)",
        "PowerShell(npm.cmd test*)",
        "Bash(npm.cmd run lint*)",
        "PowerShell(npm.cmd run lint*)"
      ],
      "deny": [
        "Bash(npm run migrate*)",
        "PowerShell(npm run migrate*)",
        "Bash(npm run prisma:migrate*)",
        "PowerShell(npm run prisma:migrate*)",
        "Bash(npm run sync:*)",
        "PowerShell(npm run sync:*)",
        "Bash(npm run stripe*)",
        "PowerShell(npm run stripe*)",
        "Bash(npm run booking-payments*)",
        "PowerShell(npm run booking-payments*)",
        "Edit(./.env*)",
        "Write(./.env*)"
      ]
    }
  },
  "reviewer": {
    "executable": "codex",
    "codex_home": "~/.codex",
    "model": "gpt-6.2-astra",
    "effort": "max",
    "timeout_minutes": 60,
    "extra_config": [
      "windows.sandbox=\"elevated\""
    ],
    "disabled_features": [
      "multi_agent",
      "apps",
      "plugins",
      "image_generation",
      "computer_use",
      "browser_use",
      "in_app_browser",
      "hooks",
      "memories"
    ]
  },
  "limits": {
    "max_review_rounds_per_checkpoint": 5,
    "max_review_attempts_per_round": 3,
    "max_developer_invocations": 30,
    "no_progress_rounds": 3,
    "publication_attempts": 4,
    "retry_backoff_seconds": [
      30,
      120
    ]
  },
  "runtime_lock_paths": [],
  "gates": {
    "unit": {
      "argv": [
        "npm.cmd",
        "test"
      ],
      "timeout_minutes": 20
    },
    "lint": {
      "argv": [
        "npm.cmd",
        "run",
        "lint"
      ],
      "timeout_minutes": 10
    }
  }
}
