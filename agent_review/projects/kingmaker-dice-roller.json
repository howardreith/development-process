{
  "schema_version": "agent-review.project.v1",
  "project_id": "kdr",
  "repository": "howardreith/KingmakerDiceRoller",
  "allowed_remote_urls": [
    "https://github.com/howardreith/KingmakerDiceRoller.git",
    "git@github.com:howardreith/KingmakerDiceRoller.git"
  ],
  "default_target_branch": "main",
  "branch_pattern": "^claude/[a-z0-9][a-z0-9._/-]*$",
  "expected_actor": "howardreith",
  "transcript_dir": "docs/agent-reviews",
  "instructions": [
    "AGENTS.md"
  ],
  "developer": {
    "executable": "%USERPROFILE%/.local/bin/claude.exe",
    "config_dir": "%USERPROFILE%/.claude-personal",
    "model": "opus",
    "effort": "high",
    "allowed_model_pattern": "^claude-opus-",
    "soft_deadline_minutes": 480,
    "grace_minutes": 60,
    "permissions": {
      "allow": [
        "PowerShell(.\\scripts\\Test-Domain.ps1 *)",
        "PowerShell(.\\scripts\\Test-Domain.ps1)",
        "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Test-Domain.ps1*)",
        "PowerShell(.\\scripts\\Validate-Repository.ps1 *)",
        "PowerShell(.\\scripts\\Validate-Repository.ps1)",
        "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Validate-Repository.ps1*)",
        "Bash(dotnet build *)",
        "PowerShell(dotnet build *)"
      ],
      "deny": [
        "PowerShell(.\\scripts\\Install.ps1*)",
        "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Install.ps1*)",
        "PowerShell(.\\scripts\\Uninstall.ps1*)",
        "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Uninstall.ps1*)",
        "PowerShell(.\\scripts\\Publish-Release.ps1*)",
        "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Publish-Release.ps1*)",
        "PowerShell(.\\scripts\\Collect-RuntimeEvidence.ps1*)",
        "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Collect-RuntimeEvidence.ps1*)"
      ]
    }
  },
  "reviewer": {
    "executable": "codex",
    "codex_home": "~/.codex",
    "model": "gpt-6.2-astra",
    "effort": "max",
    "timeout_minutes": 60,
    "extra_config": [
      "windows.sandbox=\"elevated\""
    ],
    "disabled_features": [
      "multi_agent",
      "apps",
      "plugins",
      "image_generation",
      "computer_use",
      "browser_use",
      "in_app_browser",
      "hooks",
      "memories"
    ]
  },
  "limits": {
    "max_review_rounds_per_checkpoint": 5,
    "max_review_attempts_per_round": 3,
    "max_developer_invocations": 30,
    "no_progress_rounds": 3,
    "publication_attempts": 4,
    "retry_backoff_seconds": [
      30,
      120
    ]
  },
  "runtime_lock_paths": [
    "C:/Dev/KingmakerGunslingerLab/compatibility-state/compatibility.lock",
    "C:/Dev/KingmakerBuffPlannerLab/runtime-state/deployment.lock",
    "C:/Dev/KingmakerBuffPlannerLab/runtime-fixture-state/fixture.lock",
    "C:/Dev/KingmakerMemoryLeakResearchLab/runtime-state/kmld-runtime.lock",
    "C:/Dev/KingmakerMountedCombatLab/runtime-state/active-transaction.lock",
    "C:/Dev/KingmakerSkipCinematicLab/runtime-state/runtime.lock"
  ],
  "gates": {
    "domain": {
      "argv": [
        "powershell.exe",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/Test-Domain.ps1"
      ],
      "timeout_minutes": 20
    }
  }
}
